# Copy to .env next to docker-compose.yml on the VPS (chmod 600) and fill in. Never commit the real file.
DOCKERHUB_USER=your-dockerhub-username
TAG=latest
DOMAIN=drnituporna.com

# Generate each with:  openssl rand -hex 24   (JWT_SECRET: openssl rand -hex 32)
POSTGRES_PASSWORD=
JWT_SECRET=
# First admin login password; change it later from the dashboard (Change password).
ADMIN_PASSWORD=

# The admin "Forgot password?" link is emailed here. Needs the SMTP_* values below.
ADMIN_EMAIL=nitupornasarkar2000@gmail.com
MAX_APPOINTMENTS=100

# Reset emails. Gmail: smtp.gmail.com / 587 / an app password (16 letters, no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

GOOGLE_CLIENT_ID=

# --- Used only on your laptop by build-and-push.sh (baked into the web image) ---
VITE_DOCTOR_WHATSAPP=91XXXXXXXXXX
VITE_GOOGLE_CLIENT_ID=
